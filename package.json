{
  "name": "Bookstore",
  "version": "1.0.0",
  "dependencies": {
    "@sap/cds": "^9",
    "@sap/cds-common-content": "^3.2.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "cds-plugin-ui5": "^0.13.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-bookstore-listview": "cds watch --open bookstore-listview/webapp/index.html?sap-ui-xx-viewCache=false --livereload false",
